# Regenerate from the fleet directory:
#   cd <fleet> && vhs <pilot>/docs/readme/top.tape
Output top.gif

Set Shell "bash"
Set FontSize 15
Set FontFamily "Maple Mono NF"
Set Width 1000
Set Height 400
Set Padding 20
Set WindowBar Colorful
Set Framerate 15

Hide
Type "clear"
Enter
Show
Type "pilot top"
Enter
Sleep 10s
Type "q"
Sleep 1s
